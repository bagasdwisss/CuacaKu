# Visual Crossing Weather API Key
# Dapatkan di: https://www.visualcrossing.com/weather-api
VITE_VISUALCROSSING_API_KEY=your_visual_crossing_api_key_here

# WAQI (Air Quality) API Token
# Dapatkan di: https://aqicn.org/data-platform/token/
VITE_AQI_API_KEY=your_aqi_api_token_here

# Geoapify Geocoding API Key
# Dapatkan di: https://www.geoapify.com/
VITE_GEOAPIFY_API_KEY=your_geoapify_api_key_here
